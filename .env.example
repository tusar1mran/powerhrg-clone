# Copy to .env.local for development, and set the same variables in your hosting provider for production.

# Public origin of the site, used for absolute URLs in metadata (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Contact / free-quote form delivery via Resend (https://resend.com). Server-only; never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
# Inbox that receives quote requests.
CONTACT_TO_EMAIL=
# Sender on a domain verified in Resend, e.g. "Shah & Crew Website <website@yourdomain.com>".
CONTACT_FROM_EMAIL=
